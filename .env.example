# Copy to .env in the repository root. Never commit real values.
#
# This file holds the BACKEND keys (read by backend/app/core/config.py) and the
# ANDROID BUILD key (read by frontend/android/app/build.gradle).
# The app's own settings (USE_MOCKS, API_BASE_URL, FIREBASE_*, GOOGLE_WEB_CLIENT_ID)
# go in frontend/.env instead. See frontend/.env.example.

# --- Backend ---

# Firebase / Google Cloud project ID (Firebase console > Project settings).
FIREBASE_PROJECT_ID=

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# Server-side key for Places API (New). Use a different key from the Android Maps key.
GOOGLE_PLACES_API_KEY=

# Optional. Defaults are set in backend/app/core/config.py.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MAX_ATTEMPTS=3
# GEMINI_RETRY_BUDGET_S=38
# FIRESTORE_DATABASE_ID=(default)
# GCS_BUCKET_NAME=<FIREBASE_PROJECT_ID>.firebasestorage.app
# MAX_UPLOAD_BYTES=10485760

# Optional daily limits per user on paid endpoints. 0 = no limit.
# LIMIT_VISION=150
# LIMIT_CATCH=300
# LIMIT_BRIEFING=60
# LIMIT_REHEARSAL=40
# LIMIT_REPLY=150
# LIMIT_TTS=400
# LIMIT_REVIEW=80
# LIMIT_PLACES=400
# LIMIT_EXPAND=100

# --- Android build ---

# Maps SDK for Android key, compiled into the APK. Rebuild the app after changing it.
# Write it exactly as GOOGLE_MAPS_API_KEY=value, with no spaces around the = sign.
# A Metro reload does not pick up changes to this key.
GOOGLE_MAPS_API_KEY=
