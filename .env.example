# Set to "false" so all 7 areas call the real backend instead of src/mocks/*
USE_MOCKS=false

# Optional when USE_MOCKS=false, or list specific live areas if USE_MOCKS=true:
LIVE_APIS=capture,tango,review,user,places,prepare,rehearse

# Backend URL:
# - Local backend + Android Emulator: http://10.0.2.2:8000
# - Local backend + USB Phone (with `adb reverse tcp:8000 tcp:8000`): http://localhost:8000
# - Deployed Cloud Run backend: https://fastapi-backend-<HASH>-de.a.run.app (NO trailing slash)
API_BASE_URL=http://10.0.2.2:8000

# Firebase Web App Config (Firebase Console -> Project Settings -> Your apps -> Web app)
FIREBASE_API_KEY=<YOUR_FIREBASE_WEB_API_KEY>
FIREBASE_AUTH_DOMAIN=project-79470ae0-a7db-4972-b22.firebaseapp.com
FIREBASE_PROJECT_ID=project-79470ae0-a7db-4972-b22
FIREBASE_APP_ID=<YOUR_FIREBASE_WEB_APP_ID>