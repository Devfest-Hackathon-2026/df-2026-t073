# Copy to .env and fill in with your actual API keys
# Please do NOT commit keys or remove .env from .gitignore

# Gemini API key from Google AI Studio
GEMINI_API_KEY=
# Google Maps Platform API key (Android Maps SDK; baked into the app at build time)
GOOGLE_MAPS_API_KEY=
# Server-side key for Places API (New), used by the backend only
GOOGLE_PLACES_API_KEY=
# Optional: Gemini model override (default gemini-3.5-flash)
GEMINI_MODEL=
# Firebase project ID from the Firebase console
FIREBASE_PROJECT_ID=
