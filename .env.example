# Copy to .env in the repository root (or backend/.env) and fill in.
# Never commit real keys.
#
# This file is for the backend and the Android build. The app's own settings
# (backend URL, Firebase web config, Google sign-in client ID) go in
# frontend/.env: copy frontend/.env.example.

# --- Backend ---

# Firebase / Google Cloud project ID
FIREBASE_PROJECT_ID=project-79470ae0-a7db-4972-b22
# Gemini API key from Google AI Studio (endpoints that need Gemini return 503 without it)
GEMINI_API_KEY=
# Server-side key for Places API (New). Without it, a small built-in list of places is used.
GOOGLE_PLACES_API_KEY=

# Optional (defaults shown in backend/README.md)
# GEMINI_MODEL=gemini-3.5-flash
# FIRESTORE_DATABASE_ID=(default)
# GCS_BUCKET_NAME=<FIREBASE_PROJECT_ID>.firebasestorage.app

# --- Android build ---

# Maps SDK for Android key, baked into the app at build time.
# Use a different key from GOOGLE_PLACES_API_KEY (this one is restricted to the app).
GOOGLE_MAPS_API_KEY=
