# Copy to frontend/.env for local overrides. Never commit real values.
# Restart Metro with a clean cache after changing it: npm start -- --reset-cache
#
# The Google Maps key does NOT go here. Put GOOGLE_MAPS_API_KEY in the repository-root
# .env (see the root .env.example). The Android build reads it from there.

# USE_MOCKS=false calls the backend for every area. Unset, or any other value, uses mock data.
USE_MOCKS=

# Areas that call the backend while USE_MOCKS is on, comma separated.
# Areas: places, prepare, rehearse, capture, tango, review, user.
# Everything live: capture,tango,review,user,places,prepare,rehearse
LIVE_APIS=

# Backend base URL, with no trailing slash.
# - Android emulator: http://10.0.2.2:8000 (the default when unset)
# - Phone over USB: http://localhost:8000, with `adb reverse tcp:8000 tcp:8000`
# - Cloud Run: https://<service>-<hash>-<region>.a.run.app
# Release builds block plain http://, so distributed APKs need an https:// URL.
API_BASE_URL=

# Firebase web app config: Firebase console > Project settings > Your apps > Web app.
# Under Authentication > Sign-in method, enable Google, Email/Password and Anonymous.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Google sign-in: Authentication > Sign-in method > Google > Web SDK configuration >
# Web client ID (ends in .apps.googleusercontent.com). Not a secret.
# Also register the app's SHA-1 and SHA-256 under the Android app in Firebase.
GOOGLE_WEB_CLIENT_ID=

# Optional: a fixed test account, so the app keeps the same UID across launches.
# These values are compiled into the APK, so leave them empty for any build you share.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
