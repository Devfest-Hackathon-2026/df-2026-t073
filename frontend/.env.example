# Copy to .env (frontend/.env) for local overrides. Never commit real values.
# After changing .env, restart Metro with: npm start -- --reset-cache

# "true" (default) uses mock data from src/mocks; "false" calls the backend
USE_MOCKS=
# Backend base URL, e.g. http://10.0.2.2:8000 (Android emulator -> host) or the Cloud Run URL
API_BASE_URL=
