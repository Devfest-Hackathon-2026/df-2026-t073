# Copy to .env (frontend/.env) for local overrides. Never commit real values.
# After changing .env, restart Metro with: npm start -- --reset-cache

# "true" (default) uses mock data from src/mocks; "false" calls the backend
USE_MOCKS=
# Areas that use the backend even while USE_MOCKS is on, comma separated.
# Areas: places, prepare, rehearse, capture, tango, review, user.
# Everything live: capture,tango,review,user,places,prepare,rehearse
LIVE_APIS=
# Backend base URL. Emulator: http://10.0.2.2:8000. Phone over USB: http://localhost:8000
# (plus `adb reverse tcp:8000 tcp:8000`). Or the Cloud Run URL.
API_BASE_URL=

# Firebase web app config: Firebase console > Project settings > Your apps > Web app.
# Enable Authentication > Sign-in method > Anonymous in the console too.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional: test user credentials. When set, the app signs in as this test user
# instead of an anonymous user, keeping the same persistent UID and data across runs.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
